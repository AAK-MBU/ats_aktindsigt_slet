# DEV ENVIRONMENT
TZ=Europe/Copenhagen

# ----------------------------------------------------------------------------
# Automation Server
# ----------------------------------------------------------------------------
ATS_TOKEN=INSERT_TOKEN_HERE
ATS_URL=INSERT_URL_HERE
ATS_CAPABILITIES=

# The queue THIS run populates and drains is chosen by ATS (ats.workqueue());
# locally, override it with the slet queue's id. The aktindsigt portal URL,
# credential name and DRY_RUN are set in ats_framework/processes/slet_config.py.
ATS_WORKQUEUE_OVERRIDE=WORKQUEUE_ID

# Absolute path to the ATS CA certificate (PEM). It is appended to the public
# roots (see ats_framework/helpers/config.apply_ca_bundle). Leave empty to use
# the default trust store.
AARHUS_ROOT_CERT_PEM=

# ----------------------------------------------------------------------------
# RPA database (constants, credentials incl. the aktindsigt slette-API key) —
# read by mbu_rpa_core.RPAConnection
# ----------------------------------------------------------------------------
DBCONNECTIONSTRINGPROD=Driver=INSERT_CONN_STRING_HERE
# Key the passwords in rpa.Credentials are Fernet-encrypted with. Must be the
# key they were stored with (RPAConnection.add_credential/update_credential).
OPENORCHESTRATORKEY=INSERT_KEY_HERE

# ----------------------------------------------------------------------------
# Local safety: with LOCAL_DEVELOPMENT=true every report mail is redirected to
# TestEmail.
# ----------------------------------------------------------------------------
LOCAL_DEVELOPMENT=true
TestEmail=
